# ==============================================================================
# Docker Production Environment Configuration (.env)
# Domain: bullsandbears.binaryunit.tech
# ==============================================================================

# Database Settings
MYSQL_ROOT_PASSWORD=your_secure_root_password_2026
MYSQL_DATABASE=crypto_trading
MYSQL_USER=crypto_user
MYSQL_PASSWORD=your_secure_crypto_password_2026

# ML Scanner Engine Settings
SCAN_INTERVAL_MINUTES=1
SCANNER_TOP_N=110

# Next.js API Base (leave empty for same-origin proxying via Nginx)
NEXT_PUBLIC_API_URL=

# ==============================================================================
# WhatsApp Automation & Broadcast Settings
# ==============================================================================
# Set to true to enable automated signal broadcasting to WhatsApp
WHATSAPP_ENABLED=true
# Gateway type: evolution_api (default), whapi, or webhook
WHATSAPP_GATEWAY_TYPE=evolution_api
# Internal Evolution API URL (container name:port)
WHATSAPP_API_URL=http://whatsapp:8080
# Evolution API security key
WHATSAPP_API_KEY=your_evolution_api_key_here
# Evolution API instance name (must match the paired phone)
WHATSAPP_INSTANCE_NAME=crypto_bot
# WhatsApp Group JID (e.g. 120363xxxxxxxxx@g.us) - fill after pairing
WHATSAPP_GROUP_ID=your_group_jid_here@g.us
# WhatsApp Channel/Newsletter JID (e.g. 120363xxxxxxxxx@newsletter) - fill after pairing
WHATSAPP_CHANNEL_ID=your_channel_jid_here@newsletter
# Minimum quality grade for broadcasts (Grade A or Grade A+)
WHATSAPP_MIN_GRADE=Grade A
# Minimum ML win probability (0.0-1.0) to broadcast a signal
WHATSAPP_MIN_WIN_PROB=0.70
# Send TP (Take Profit) hit notifications
WHATSAPP_SEND_TP_UPDATES=true
# Send SL (Stop Loss) hit notifications
WHATSAPP_SEND_SL_UPDATES=true
# Send BTC market regime shift alerts
WHATSAPP_SEND_REGIME_ALERTS=true
# Anti-ban delay between messages (seconds)
WHATSAPP_RATE_LIMIT_SECONDS=2.0
