FROM python:3.10-slim

# Prevent Python from buffering stdout/stderr and writing .pyc files
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV CUDA_VISIBLE_DEVICES="-1"
ENV TF_CPP_MIN_LOG_LEVEL="3"
ENV TF_ENABLE_ONEDNN_OPTS="0"

# Install system dependencies (build tools and OpenMP runtime for XGBoost/LightGBM/CatBoost)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first for caching efficiency
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application files, ML models, and configuration
COPY app/ ./app/
COPY trading_ai_system/ ./trading_ai_system/
COPY data/ ./data/
COPY models_export_v3/ ./models_export_v3/
COPY export_app_data/ ./export_app_data/
COPY user_pasted_signals.csv .
COPY test.py .
COPY train_meta_labeler.py .
COPY run_scanner_daemon.py .
COPY test_v16_regression.py .
COPY run_all_v16_tests.py .
COPY test_suite_engine.py .
COPY tests/ ./tests/

# Create directories for app data, models, and candle cache
RUN mkdir -p /app/export_app_data /app/models_export_v3 /app/data/cache

EXPOSE 8000

# Default command runs FastAPI Backend via Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
