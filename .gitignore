# ==============================================================================
# Comprehensive .gitignore for Crypto Quantitative Trading System (Backend + Frontend)
# ==============================================================================

# Node / Next.js / Frontend
node_modules/
*/node_modules/
.next/
*/.next/
out/
build/
dist/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# CatBoost / ML Run artifacts
catboost_info/
*/catboost_info/

# Machine Learning Models & Heavy Checkpoints (Export directories)
# Heavy DL checkpoints
*.h5
*.keras
*.cbm

# Allow tracking models_export_v3 production meta-classifier & seed signals
!models_export_v3/
!models_export_v3/**
!user_pasted_signals.csv

# Temporary export data & database files
export_app_data/*.csv
export_app_data/*.json
*.log
*.sqlite
*.sqlite3
*.db

# IDE & Editor files
.vscode/
.idea/

# Local Deployment & Profiling Scripts with VPS credentials
profile_vps.py
scratch_test_asset.py
deploy_vps.py
*.swp
*.swo
*~
.directory

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
