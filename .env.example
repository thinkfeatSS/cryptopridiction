# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PROJECT_NAME="Quantitative Crypto Trading Terminal"

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=crypto_trading

# Full SQLAlchemy Database URL
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/crypto_trading

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api
EXPORT_DIR=./export_app_data

# Fundamental, Event Catalyst & News Intelligence API Keys (Optional)
# The system works automatically with built-in zero-config public feeds if left blank.
COINMARKETCAL_API_KEY=
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=
CRYPTOPANIC_API_KEY=

# Remote Infrastructure & Administration (Excluded from version control)
VPS_HOST=127.0.0.1
VPS_PORT=22
VPS_USER=root
VPS_KEY_PATH=~/.ssh/id_rsa
# Fallback password only if SSH key authentication unavailable
VPS_PASSWORD=

