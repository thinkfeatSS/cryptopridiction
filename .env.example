# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PROJECT_NAME="Quantitative Crypto Trading Terminal"

# MySQL Database Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=crypto_trading

# Full SQLAlchemy Database URL
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/crypto_trading

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api
EXPORT_DIR=./export_app_data
